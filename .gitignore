# Data files (too large for git) - CSV, JSON, parquet, etc.
*.json
*.parquet
*.pkl
*.h5
*.hdf5

# Ignore all data directories by default
data/raw/**
data/processed/**
data/curated/**

# EXCEPT allow master dataset and summary
!data/processed/master_cardiovascular_metaanalysis_*trials.csv
!data/processed/master_dataset_summary.txt

# Except example/small test data
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/curated/.gitkeep
!data/metadata/.gitkeep

# Allow sample meta-analysis data (small, for demos)
!data/raw/sample_metaanalysis/
!data/raw/sample_metaanalysis/*.csv

# Allow validation datasets (small, important for project validation)
!data/raw/validation_datasets/
!data/raw/validation_datasets/*.csv

# Allow validation results (small, documents method performance)
!data/processed/validation_results/
!data/processed/validation_results/*.csv

# Allow advanced datasets (for meta-regression, dose-response, NMA)
!data/raw/advanced_datasets/
!data/raw/advanced_datasets/*.csv

# Allow Phase 1 expansion datasets (74 trials: ACS, AF, TAVI)
!data/raw/phase1_expansion/
!data/raw/phase1_expansion/*.csv

# Allow Phase 2 expansion datasets (100 trials: HTN, HF, Lipids, Valvular)
!data/raw/phase2_expansion/
!data/raw/phase2_expansion/*.csv

# Allow Phase 3 expansion datasets (75+ trials: Diabetes, Stroke, PVD)
!data/raw/phase3_expansion/
!data/raw/phase3_expansion/*.csv

# Allow Phase 4 expansion datasets (100+ trials: Devices, Coronary, Anti-inflammatory, Historical)
!data/raw/phase4_expansion/
!data/raw/phase4_expansion/*.csv

# Allow Phase 5 expansion datasets (CKD trials)
!data/raw/phase5_expansion/
!data/raw/phase5_expansion/*.csv

# Allow Phase 6 expansion datasets (Arrhythmia trials)
!data/raw/phase6_expansion/
!data/raw/phase6_expansion/*.csv

# Allow Phase 7 expansion datasets (Preventive trials)
!data/raw/phase7_expansion/
!data/raw/phase7_expansion/*.csv

# Allow Phase 8 expansion datasets (Cardiomyopathy trials)
!data/raw/phase8_expansion/
!data/raw/phase8_expansion/*.csv

# Allow Phase 9 expansion datasets (Additional domains: Pulmonary HTN, Women's Health, etc.)
!data/raw/phase9_expansion/
!data/raw/phase9_expansion/*.csv

# Allow Phase 10 expansion datasets (Cardiac Surgery trials)
!data/raw/phase10_expansion/
!data/raw/phase10_expansion/*.csv

# Allow Phase 11 emerging domains (Cardio-Renal-Metabolic, Advanced Rhythm, MCS, etc.)
!data/raw/phase11_emerging/
!data/raw/phase11_emerging/*.csv

# Allow Phase 12 specialized populations (Cardio-Oncology, HIV, Inflammatory, Pregnancy, ACHD)
!data/raw/phase12_specialized/
!data/raw/phase12_specialized/*.csv

# Allow Phase 13 advanced imaging (CT-FFR, CMR, PET, Stress imaging, Advanced echo)
!data/raw/phase13_imaging/
!data/raw/phase13_imaging/*.csv

# Allow Phase 14 rare conditions (Takotsubo, INOCA, SCAD, Bridging, Rare syndromes)
!data/raw/phase14_rare_conditions/
!data/raw/phase14_rare_conditions/*.csv

# Allow Phase 15 quality/systems (Remote monitoring, Quality improvement, Decision support, Transitional care, Digital health)
!data/raw/phase15_quality_systems/
!data/raw/phase15_quality_systems/*.csv

# Allow Phase 16 additional domains (Sleep apnea, Genetic conditions, CTO PCI, Antiplatelet, Nutrition/cachexia)
!data/raw/phase16_additional_domains/
!data/raw/phase16_additional_domains/*.csv

# Allow Phase 17 additional domains 2 (Cardiac arrest, Advanced HF/transplant, Additional PVD, Gender-specific, PE treatment)
!data/raw/phase17_additional_domains2/
!data/raw/phase17_additional_domains2/*.csv

# Allow Phase 18 additional domains 3 (Biomarker-guided, Anticoagulation, Cardiac rehab, Pericardial, Structural heart)
!data/raw/phase18_additional_domains3/
!data/raw/phase18_additional_domains3/*.csv

# Allow Phase 19 additional domains 4 (Antiarrhythmic drugs, HF devices, Myocarditis, Cardiogenic shock/MCS, Electrophysiology)
!data/raw/phase19_additional_domains4/
!data/raw/phase19_additional_domains4/*.csv

# Allow Phase 20 additional domains 5 (Additional valve, HCM, VTE prophylaxis, Additional stroke, Additional metabolic/diabetes)
!data/raw/phase20_additional_domains5/
!data/raw/phase20_additional_domains5/*.csv

# Allow Phase 21 additional domains 6 (Additional antiplatelet, Bleeding risk, Additional HTN, Platelet function testing, Additional preventive)
!data/raw/phase21_additional_domains6/
!data/raw/phase21_additional_domains6/*.csv

# Allow Phase 22 final expansion - 1000+ TRIAL MILESTONE! (ACS, CHF pharm, Interventional, Arrhythmia, Risk factors, Women's health, Elderly, Clinical scenarios)
!data/raw/phase22_final_expansion/
!data/raw/phase22_final_expansion/*.csv

# Allow meta-analysis results (comprehensive analysis of 1001 trials)
!data/analysis/
!data/analysis/meta_analysis_results/
!data/analysis/meta_analysis_results/*.csv
!data/analysis/meta_analysis_results/*.png
!data/analysis/meta_analysis_results/*.md

